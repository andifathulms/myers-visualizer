    "test:determinism": "vitest run tests/determinism",
    "bench:render": "node scripts/bench-render.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
